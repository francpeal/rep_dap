          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="vta_prom_6m">
          <DataField>vta_prom_6m</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="stock_actual">
          <DataField>stock_actual</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="dispo_1m">
          <DataField>dispo_1m</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
